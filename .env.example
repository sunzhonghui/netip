# NetIP Configuration Example

# Mode: "server" (master web + API) or "probe" (worker probe node)
MODE=server

HTTP_ADDR=:8080

# Domain Configuration
PUBLIC_DOMAIN=ip.ipw.3x.cx
PUBLIC_APP_ORIGIN=https://ip.ipw.3x.cx

IPV4_DOMAIN=4.ipw.3x.cx
IPV6_DOMAIN=6.ipw.3x.cx
TEST_DOMAIN=test.ipw.3x.cx

# Trusted Reverse Proxy CIDRs (e.g. Caddy/Nginx local or docker internal subnet)
# X-Forwarded-For and X-Real-IP are ONLY parsed if direct connection is within these CIDRs.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,::1/128,fd00::/8

# Persistent data directory
DATA_DIR=/data

# Multi-DNS Resolvers list (comma-separated)
DNS_RESOLVERS=system,1.1.1.1,8.8.8.8,223.5.5.5,119.29.29.29

# Permitted TCP Ports for TCPing and SSL diagnostics
ALLOWED_TCP_PORTS=22,53,80,443,465,587,993,995,3389

# Observability
LOG_LEVEL=info
LOG_CLIENT_IP=true
METRICS_ENABLED=true

# Distributed Probe Configuration File
PROBE_CONFIG=/config/probes.yaml

# Probe Node Credentials (only required when running in MODE=probe)
# PROBE_ID=cn-beijing-01
# PROBE_NAME=北京
# PROBE_ISP=中国电信
# PROBE_SECRET=your-secure-shared-secret-here
